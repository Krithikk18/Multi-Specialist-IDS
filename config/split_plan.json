{
 "version": "v1.0",
 "note": "Tunables for 08_build_datasets.py. Session keys are the real flow-dir stems (ATTACK_FLOWS_DIR/<stem>/<stem>_labelled.csv.gz) plus benign_night (data/interim/flows/benign/benign_flows_tagged.csv). Families are config/attack_set.json's attack_family values.",
 "seed": 42,
 "gap_seconds": 120,
 "gap_on_train_val_cut": true,
 "time_basis": "active",
 "time_basis_note": "active: fractions of a session's ACTIVE time (idle gaps between capture segments do not count); range: fractions of the wall-clock span first..last flow start",
 "active_idle_gap_seconds": 300,
 "time_fracs": {"train": 0.70, "val": 0.15, "test": 0.15},
 "val_frac_of_train_sessions": 0.15,
 "sessions": {
  "benign_night":     "time_split",
  "DDoS-SYN_Flood":   "train",
  "DDoS-SYN_Flood5":  "train",
  "DDoS-SYN_Flood10": "test",
  "DDoS-SYN_Flood15": "test",
  "Recon-PortScan":   "time_split",
  "Mirai-udpplain":   "train",
  "Mirai-udpplain24": "test"
 },
 "session_aliases": {
  "DDoS-SYN_Flood":   "SYN first part",
  "DDoS-SYN_Flood5":  "SYN 5",
  "DDoS-SYN_Flood10": "SYN 10",
  "DDoS-SYN_Flood15": "SYN 15",
  "Recon-PortScan":   "Recon-PortScan",
  "Mirai-udpplain":   "Mirai first part",
  "Mirai-udpplain24": "Mirai 24"
 },
 "caps": {
  "train_benign_per_device": 20000,
  "attack_per_family_per_group": {"train": 200000, "val": 50000, "test": 200000},
  "never_cap_families": ["udp_flood", "port_scan"],
  "never_cap_families_aliases": {"udp_flood": "Mirai", "port_scan": "Recon"}
 },
 "min_test_attack_warn": 20
}
