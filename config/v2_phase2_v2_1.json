{
 "version": 1,
 "note": "Phase 2 tunables for the closeout re-run on v2_1_oriented: a copy of config/v2_phase2.json with the dataset, results folder, prereg amendment, orientation normaliser and the Amendment 1 primary-selection rule added (docs/V2_PREREG_PHASE2_AMENDMENT_1.md). Loaded and validated by common/phase2_config.py; every run records this file's sha256.",
 "dataset_version": "v2_1_oriented",
 "results_subdir": "v2_1",
 "prereg_amendments": ["docs/V2_PREREG_PHASE2_AMENDMENT_1.md"],
 "orientation": {"map": "config/orientation_map.json", "rule": "R3"},
 "primary_selection": {"rule": "amendment_1_section_2", "amendment": "docs/V2_PREREG_PHASE2_AMENDMENT_1.md", "tolerance": 0.005, "tie_order": ["none", "sqrt", "balanced"]},
 "paths": {
  "datasets_root": "~/lgids_cache/v2/datasets",
  "cache_root": "~/lgids_cache/v2",
  "registry_root": "~/lgids_cache/v2/registry",
  "keys_dir": "~/lgids_cache/v2/keys",
  "v1_models_dir": "~/lgids_cache/models/step10"
 },
 "columns": {
  "group": "group",
  "label_id": "label_id",
  "session": "session",
  "start_ts": "start_ts",
  "device_category": "device_category"
 },
 "fallback_group": "GEN",
 "seeds": [0, 1, 2, 3, 4],
 "min_val_flows": 50,
 "inner_split_frac": 0.10,
 "dry_run": {"frac": 0.05, "seed": 0},
 "class_weights": {"primary": "sqrt", "ablation_modes": ["none", "balanced"]},
 "xgb": {
  "params_source": "V1 09_train_specialists.py build_model: XGBoost 3.4.2 library defaults (scale_pos_weight replaced by class weights); written out explicitly",
  "params": {
   "objective": "multi:softprob",
   "eval_metric": "mlogloss",
   "tree_method": "hist",
   "eta": 0.3,
   "max_depth": 6,
   "min_child_weight": 1,
   "subsample": 1.0,
   "colsample_bytree": 1.0,
   "lambda": 1.0,
   "alpha": 0.0,
   "gamma": 0.0,
   "max_bin": 256,
   "nthread": -1
  },
  "num_boost_round": 100,
  "early_stopping_rounds": 10
 },
 "ablations": {
  "A1_class_weights": true,
  "A2_gen_specialist": true,
  "A3_device_category": true,
  "a3_min_benign_train": 100
 },
 "eval": {
  "ci_level": 0.95,
  "benign_hours_idle_gap_s": 300,
  "fp_threshold_max_fp": 2,
  "latency_batch1_repeats": 1000,
  "latency_batch": 1024,
  "latency_batch_repeats": 20,
  "v1_binary_compare": true
 },
 "calibration": {"cross_fit_folds": 2, "ece_bins": 15, "temperature_bounds": [0.05, 20.0]},
 "shap": {"shap_per_class": 2000, "top_k_heatmap": 20, "beeswarm_top": 15, "dominance_threshold": 0.5},
 "registry": {"states": ["candidate", "approved", "promoted"], "register_seed": 0}
}
