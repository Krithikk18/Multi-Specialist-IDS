+	/** 64-bit FNV-1a over the key's chars, then the SplitMix64 finaliser. */
+	private static long keyHash(String key) {
+		long h = 0xcbf29ce484222325L;
+		for (int i = 0; i < key.length(); i++) {
+			h ^= key.charAt(i);
+			h *= 0x100000001b3L;
+		}
+		h ^= (h >>> 30); h *= 0xbf58476d1ce4e5b9L;
+		h ^= (h >>> 27); h *= 0x94d049bb133111ebL;
+		h ^= (h >>> 31);
+		return h;
+	}
+
+	/** Open-addressing set of longs (linear probing, backward-shift delete); 8 bytes per slot. */
+	private static final class LongHashSet {
+		private static final long EMPTY = 0L;
+		private long[] slots = new long[1 << 16];
+		private int size = 0;
+
+		int size() { return size; }
+
+		private static long norm(long k) { return k == EMPTY ? 1L : k; }
+
+		private int idx(long k) { return (int) (k ^ (k >>> 32)) & (slots.length - 1); }
+
+		void add(long k) {
+			k = norm(k);
+			if ((size + 1) * 2 > slots.length) grow();
+			int i = idx(k);
+			while (slots[i] != EMPTY) {
+				if (slots[i] == k) return;
+				i = (i + 1) & (slots.length - 1);
+			}
+			slots[i] = k;
+			size++;
+		}
+
+		boolean remove(long k) {
+			k = norm(k);
+			int mask = slots.length - 1, i = idx(k);
+			while (slots[i] != EMPTY) {
+				if (slots[i] == k) {
+					// backward-shift deletion keeps every probe chain intact
+					int hole = i, j = i;
+					while (true) {
+						j = (j + 1) & mask;
+						if (slots[j] == EMPTY) break;
+						int home = idx(slots[j]);
+						if (((j - home) & mask) >= ((j - hole) & mask)) {
+							slots[hole] = slots[j];
+							hole = j;
+						}
+					}
+					slots[hole] = EMPTY;
+					size--;
+					return true;
+				}
+				i = (i + 1) & mask;
+			}
+			return false;
+		}
+
+		private void grow() {
+			long[] old = slots;
+			slots = new long[old.length * 2];
+			size = 0;
+			for (long k : old) if (k != EMPTY) add(k);
+		}
+	}
