+    /** Emit and remove every flow past flowTimeOut + slack at capture time {@code now}. */
+    private void sweepIdle(long now) {
+		sweeps++;
+		Iterator<Map.Entry<String, BasicFlow>> it = currentFlows.entrySet().iterator();
+		while (it.hasNext()) {
